{
  "name": "primitive-decoder",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first procedural system visualisation engine",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Primitivelabai/decoder.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/engine/*.test.ts",
    "test:core": "node scripts/test-core.mjs",
    "verify:exports": "tsx scripts/verify-exports.ts",
    "check": "npm run format:check && npm run lint && npm run test:core && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "decoder": "tsx cli/decoder.ts",
    "install-skill": "node scripts/install-skill.mjs",
    "bundle:standalone": "node scripts/build-standalone.mjs",
    "predev": "npm run bundle:standalone",
    "prebuild": "npm run bundle:standalone",
    "pretest": "npm run bundle:standalone",
    "predecoder": "npm run bundle:standalone",
    "preverify:exports": "npm run bundle:standalone",
    "prelint": "npm run bundle:standalone"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "ajv": "^8.20.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "three-bvh-csg": "^0.0.19",
    "three-gpu-pathtracer": "^0.0.28",
    "three-mesh-bvh": "^0.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
